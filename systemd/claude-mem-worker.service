[Unit]
Description=claude-mem worker (web viewer on :37777 + MCP loopback)
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=%h
ExecStart=%h/projects/anamnestic/bin/claude-mem-worker.sh foreground
ExecStop=%h/projects/anamnestic/bin/claude-mem-worker.sh stop
Restart=on-failure
RestartSec=10
StandardOutput=append:%h/.claude-mem/logs/worker-stdout.log
StandardError=append:%h/.claude-mem/logs/worker-stderr.log

# --- resource limits ---
MemoryMax=2G
CPUQuota=100%
TasksMax=256

# --- scheduling ---
Nice=5

# --- hardening ---
NoNewPrivileges=yes

[Install]
WantedBy=default.target
